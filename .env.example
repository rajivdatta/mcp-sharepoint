# Nothing here is required for the default (broker / delegated) setup.

# --- embeddings: Azure OpenAI (recommended when you want semantic search) ----
# AZURE_OPENAI_ENDPOINT=https://<your-aoai>.openai.azure.com
# AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small
# AZURE_OPENAI_API_KEY=            # omit to use your Entra sign-in instead
#                                  # (needs role: Cognitive Services OpenAI User)

# --- embeddings: OpenAI direct (only if permitted) --------------------------
# OPENAI_API_KEY=

# --- app-only auth (NOT recommended - no permission trimming) ---------------
# SHAREPOINT_CLIENT_SECRET=
# SHAREPOINT_CERT_PASSWORD=
